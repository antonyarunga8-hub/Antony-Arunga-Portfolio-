# Flask Environment Configuration Template
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Strict Admin Dashboard Access
ADMIN_USERNAME=antony
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=your-random-admin-session-secret

# Database Configuration
# Local Development: sqlite:///portfolio.db
# Production (Render/Neon): postgresql://username:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///portfolio.db
